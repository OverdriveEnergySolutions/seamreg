{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seams registry",
  "description": "Pieces of knowledge kept in two or more files that must agree, and the automated checks (ties) that fail when they drift.",
  "type": "object",
  "required": [
    "schema_version",
    "seams"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "rules",
            "cursor",
            "copilot",
            "claude-md",
            "claude-md-high",
            "agents-md",
            "agents-md-high"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "rules",
              "cursor",
              "copilot",
              "claude-md",
              "claude-md-high",
              "agents-md",
              "agents-md-high"
            ]
          }
        }
      ],
      "description": "Where `seams_check.py --notes` puts a note for each seam. One value, or a list for a repo that more than one kind of agent works in. rules: one .claude/rules/seams/<id>.md per seam, which Claude Code loads when an agent reads a copy. cursor: one .cursor/rules/seams/<id>.mdc per seam, attached when a copy is in context. copilot: one .github/instructions/seams-<id>.instructions.md per seam, applied to its copies. claude-md and agents-md: a block in the nearest CLAUDE.md or AGENTS.md, high and medium risk only. claude-md-high and agents-md-high: the same block with high risk only. Leave it out for no notes."
    },
    "seams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "must_agree",
          "copies",
          "consequence",
          "risk"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Stable kebab-case slug. Do not rename it: other tools key on it."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "mirror",
              "contract",
              "vocabulary",
              "copied-helper",
              "config",
              "schema",
              "convention"
            ]
          },
          "must_agree": {
            "type": "string",
            "minLength": 1,
            "description": "One sentence: what must stay the same."
          },
          "copies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Repo-relative path with forward slashes. May be a glob: * and ? stay inside one folder, ** spans folders."
                },
                "symbol": {
                  "type": "string",
                  "minLength": 3,
                  "description": "Text that must appear in the file: a function, constant or section name. Prefer it to a line number, which goes stale."
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "consequence": {
            "type": "string",
            "minLength": 1,
            "description": "What goes wrong when one copy changes alone."
          },
          "intentional_differences": {
            "type": [
              "string",
              "null"
            ],
            "description": "Deliberate differences, so nobody 'fixes' them."
          },
          "single_source": {
            "type": "boolean",
            "description": "True when one shared module now holds the knowledge and the copies listed are what remains outside it."
          },
          "ties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "covers"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The test file, CI config or script that fails on drift."
                },
                "test": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Test name or CI step name. It must appear in the file."
                },
                "covers": {
                  "enum": [
                    "all",
                    "partial"
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Required when covers is partial: which copies it checks."
                }
              }
            }
          },
          "risk": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "suggested_tie": {
            "type": [
              "string",
              "null"
            ],
            "description": "The cheapest check that would catch drift. Add it with the next fix to this seam."
          },
          "drift": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "text",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "What differs now, with path:line on each side."
              },
              "source": {
                "enum": [
                  "reading",
                  "confirmed"
                ],
                "description": "reading: found by reading the code. confirmed: seen at runtime or checked by hand. Treat reading as a lead, not a bug."
              },
              "seen": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "sensitive": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where private detail lives (a private issue, say). Never the detail itself."
          }
        }
      }
    }
  }
}

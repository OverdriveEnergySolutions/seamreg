{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/seams_check.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/seams_check.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" --stop-hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
